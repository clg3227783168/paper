\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Physical mock circulatory loop platform for ventricular assist device physiological control experiments. The platform includes a pulsatile motor, volume chamber, compliance chamber, damping chamber, flowmeter, and left ventricular chamber to emulate cardiovascular hemodynamic conditions.}}{5}{}\protected@file@percent }
\newlabel{fig:mcl_platform}{{2}{5}{}{figure.2}{}}
