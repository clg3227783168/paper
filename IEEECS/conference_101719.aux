\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Training and evaluation pipeline of the proposed physiological VAD controller. The workflow links physiological scenario construction, signal preprocessing, CNN-Transformer representation pretraining, online actor-critic optimization, and downstream transition, robustness, safety, and ablation analyses.}}{5}{}\protected@file@percent }
\newlabel{fig:training_evaluation_pipeline}{{3}{5}{}{figure.3}{}}
