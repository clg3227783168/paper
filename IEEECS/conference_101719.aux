\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Comparative MAP regulation during a rest-activity-recovery transition. The proposed CNN-Transformer controller is compared with existing DRL, rule-based, and fixed-speed baselines. The green band denotes the target MAP range, and the shaded windows mark the activity and recovery intervals.}}{6}{}\protected@file@percent }
\newlabel{fig:comparative_control_performance}{{4}{6}{}{figure.4}{}}
