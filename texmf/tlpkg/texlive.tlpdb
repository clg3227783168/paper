name 00texlive.installation
category TLCore
depend opt_location:https://mirror.ctan.org/systems/texlive/tlnet
depend setting_available_architectures:
depend setting_usertree:1

name acmart
category Package
revision 79508
shortdesc Class for typesetting publications of ACM
longdesc This package provides a class for typesetting publications of
longdesc the Association for Computing Machinery (ACM).
containersize 43988
containerchecksum a0b32c447d3f6f3c18fd8ddbb5df1c88b4e23ad90827223894e96a8955da70cad1d0821336e9cbf78a92c860bb458bab8f807f55b9e049f0bfae79f20bf607bb
